{
  "name": "chronicle",
  "version": "0.0.0",
  "homepage": "https://github.com/uzaira0/chronicle-web",
  "description": "Self-hosted research administration web application for Chronicle.",
  "author": {
    "name": "Baylor College of Medicine",
    "email": "uzairalam998@gmail.com",
    "url": "https://www.bcm.edu"
  },
  "contributors": [
    {
      "name": "Hristo Oskov",
      "email": "hristo@openlattice.com"
    },
    {
      "name": "Alfonce Nzioka",
      "email": "alfonce@openlattice.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uzaira0/chronicle-web.git"
  },
  "bugs": {
    "url": "https://github.com/uzaira0/chronicle-web/issues"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "bun": "1.4.4"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@eqds/css": "file:vendor/equal/packages/css",
    "@eqds/icons": "file:vendor/equal/packages/icons",
    "@eqds/tokens": "file:vendor/equal/packages/tokens",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@reduxjs/toolkit": "^2.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.2.0",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.2",
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "^2.4.10",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.56.1",
    "@shadcn/lint": "^0.2.0",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "bun-types": "1.4.4",
    "eslint": "^10.8.0",
    "fast-check": "^4.6.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.12.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "zod": "^4.6.7",
    "postcss": "^8.5.23"
  },
  "overrides": {
    "qs": "~6.16.1",
    "fast-uri": "^4.2.3",
    "minimatch": "11.0.1"
  },
  "scripts": {
    "build": "bun ./scripts/build-modern.ts",
    "check": "bun run typecheck && bun run lint:types && bun run lint:design && bun run biome:check && bun run lint:ast && bun run test:e2e-dsl && bun run i18n:lint && bun run check:api-types && bun run check:domain-contracts",
    "lint:ast": "ast-grep scan -c sgconfig.yml e2e/",
    "lint:types": "eslint src/modern e2e scripts",
    "lint:design": "eslint --config eslint.shadcn.mjs src/modern --max-warnings 0",
    "test:e2e-dsl": "bun test e2e/dsl/",
    "clean": "bun -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "dev": "bun ./scripts/dev-local.ts",
    "dev:local": "bun ./scripts/dev-local.ts",
    "preview": "bun ./scripts/serve-modern-preview.ts",
    "serve": "bun ./scripts/serve-modern-preview.ts",
    "e2e": "bunx playwright test",
    "e2e:headed": "bunx playwright test --headed",
    "e2e:selfhost": "bunx playwright test e2e/selfhost-journey.spec.ts --project=desktop-chromium",
    "e2e:install": "bunx playwright install chromium firefox webkit",
    "test:e2e:smoke": "bunx playwright test e2e/modern-shell.spec.ts --project=desktop-chromium",
    "biome:check": "bunx biome check src/modern/",
    "biome:fix": "bunx biome check --write src/modern/",
    "biome:format": "bunx biome format --write src/",
    "test": "bun test --preload ./src/modern/test/setup-dom.ts src/modern",
    "test:components": "bun test --preload ./src/modern/test/setup-dom.ts src/modern/components",
    "test:routes": "bun test --preload ./src/modern/test/setup-dom.ts src/modern/routes/*.test.tsx",
    "test:ui": "bun run test:components && bun run test:routes",
    "test:mutate": "bunx stryker run",
    "dead-code": "bunx knip",
    "check:domain-contracts": "bun ./scripts/check-domain-contracts.ts",
    "generate:api-types": "bunx openapi-typescript ../chronicle-api/chronicle.yaml -o src/modern/types/chronicle-api.generated.ts",
    "check:api-types": "bunx openapi-typescript ../chronicle-api/chronicle.yaml | diff -u src/modern/types/chronicle-api.generated.ts - >/dev/null || (echo 'chronicle-api.generated.ts is stale: run bun run generate:api-types' >&2; exit 1)",
    "typecheck": "bun run typecheck:app && bun run typecheck:scripts",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "i18n:sync-catalog": "bun --tsconfig-override tsconfig.app.json scripts/i18n-sync-catalog.ts && bunx biome format --write src/modern/i18n/en/translation.json",
    "i18n:report": "bun scripts/i18n-report.ts",
    "i18n:lint": "ast-grep scan src/modern"
  },
  "patchedDependencies": {
    "@redocly/openapi-core@1.34.22": "vendor/patches/@redocly%2Fopenapi-core@1.34.22.patch"
  }
}
