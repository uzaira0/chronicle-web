  "scripts": {
    "build": "bun ./scripts/build-modern.ts",
    "check": "bun run typecheck && bun run lint:types && bun run biome:check && bun run lint:ast && bun run test:e2e-dsl && bun run i18n:lint && bun run i18n:lint:selftest",
    "lint:ast": "ast-grep scan -c sgconfig.yml e2e/",
    "lint:types": "eslint src/modern e2e scripts",
    "test:e2e-dsl": "bun test e2e/dsl/",
    "clean": "bunx rimraf dist/*",
    "dev": "bun --port 5173 index.html",
    "dev:local": "bun ./scripts/dev-local.ts",
    "preview": "PORT=4173 bun ./scripts/serve-modern-preview.ts",
    "serve": "bun ./scripts/serve-modern-preview.ts",
    "e2e": "bunx playwright test",
    "e2e:headed": "bunx playwright test --headed",
    "e2e:selfhost": "bunx playwright test e2e/selfhost-journey.spec.ts --project=desktop-chromium",
    "e2e:install": "bunx playwright install chromium firefox webkit",
    "test:e2e:smoke": "bunx playwright test e2e/modern-shell.spec.ts --project=desktop-chromium",
    "biome:check": "bunx biome check src/modern/ src/core/",
    "biome:fix": "bunx biome check --write src/modern/ src/core/",
    "biome:format": "bunx biome format --write src/",
    "test": "bun test src/modern/lib src/modern/state src/modern/stores src/bun-legacy && bun run test:ui",
    "test:components": "bun test --preload ./src/modern/test/setup-dom.ts src/modern/components",
    "test:routes": "bun test --preload ./src/modern/test/setup-dom.ts src/modern/routes/*.test.tsx",
    "test:ui": "bun run test:components && bun run test:routes",
    "test:mutate": "bunx stryker run",
    "size": "bunx size-limit",
    "size:check": "bunx size-limit --json",
    "dead-code": "bunx knip",
    "check:domain-contracts": "bun ./scripts/check-domain-contracts.ts",
    "generate:api-types": "bunx openapi-typescript ../chronicle-api/chronicle.yaml -o src/modern/types/chronicle-api.generated.ts",
    "check:api-types": "bun run generate:api-types && git diff --exit-code src/modern/types/chronicle-api.generated.ts",
    "typecheck": "bun run typecheck:app && bun run typecheck:scripts",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "i18n:sync-catalog": "bun --tsconfig-override tsconfig.app.json scripts/i18n-sync-catalog.ts",
    "i18n:report": "bun scripts/i18n-report.ts",
    "i18n:lint": "ast-grep scan src/modern",
    "i18n:lint:selftest": "bash scripts/i18n-lint-selftest.sh"
  }
}
